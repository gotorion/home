{{!< default}}
{{#post}}
<article class="post page">
    {{#if @page.show_title_and_feature_image}}
        <header class="post-header container container--narrow">
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="post-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </header>

        {{#if feature_image}}
            <figure class="post-featured container">
                <img src="{{img_url feature_image size="xl"}}"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}
    {{/if}}

    <div class="post-content container container--narrow">
        {{content}}
    </div>
</article>
{{/post}}
