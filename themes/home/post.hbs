{{!< default}}
{{#post}}
<article class="post">
    <header class="post-header container container--narrow">
        <div class="post-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
            {{#if primary_tag}}
                <span class="meta-sep" aria-hidden="true">/</span>
                <a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
            {{/if}}
        </div>

        <h1 class="post-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
        {{else}}
            {{#if excerpt}}
                <p class="post-excerpt">{{excerpt}}</p>
            {{/if}}
        {{/if}}

        <div class="post-byline">
            {{#if primary_author.profile_image}}
                <img class="byline-avatar" src="{{primary_author.profile_image}}" alt="" loading="lazy">
            {{/if}}
            <span class="byline-name">{{primary_author.name}}</span>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>{{reading_time minute="1 分钟" minutes="% 分钟"}}</span>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-featured container">
            <img src="{{img_url feature_image size="xl"}}"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}
                <figcaption>{{feature_image_caption}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    <div class="post-content container container--narrow">
        {{content}}
    </div>

    <footer class="post-footer container container--narrow">
        {{#if tags}}
            <div class="post-tags" aria-label="标签">
                {{#foreach tags}}
                    <a class="chip" href="{{url}}">{{name}}</a>
                {{/foreach}}
            </div>
        {{/if}}

        <button class="button button-ghost copy-link" type="button" data-copy-url="{{url absolute="true"}}">
            复制链接
        </button>
    </footer>
</article>

{{#if primary_tag}}
    {{#get "posts" filter="tag:{{primary_tag.slug}}+id:-{{id}}" limit="3" as |related|}}
        {{#foreach related}}
            {{#if @first}}
                <section class="related container">
                    <h2 class="section-title">相关文章</h2>
                    <div class="post-grid">
            {{/if}}

            {{> "post-card"}}

            {{#if @last}}
                    </div>
                </section>
            {{/if}}
        {{/foreach}}
    {{/get}}
{{/if}}

{{> "subscribe"}}
{{/post}}
