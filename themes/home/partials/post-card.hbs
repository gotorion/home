<article class="post-card">
    <a class="post-card-link" href="{{url}}">
        {{#if feature_image}}
            <div class="post-card-media">
                <img src="{{img_url feature_image size="m"}}"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     loading="lazy">
            </div>
        {{/if}}

        <div class="post-card-body">
            {{#primary_tag}}
                <span class="post-card-tag">{{name}}</span>
            {{/primary_tag}}

            <h2 class="post-card-title">{{title}}</h2>

            {{#if excerpt}}
                <p class="post-card-excerpt">{{excerpt}}</p>
            {{/if}}

            <div class="post-card-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span>{{reading_time minute="1 分钟" minutes="% 分钟"}}</span>
            </div>
        </div>
    </a>
</article>
