<header class="site-header" id="site-header">
    <div class="container header-inner">
        <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}}">
            {{#if @site.icon}}
                <img class="brand-icon" src="{{@site.icon}}" alt="" width="28" height="28">
            {{else}}
                <span class="brand-mark" aria-hidden="true">{{@site.title.[0]}}</span>
            {{/if}}
            <span class="brand-name">{{@site.title}}</span>
        </a>

        <nav class="site-nav" id="site-nav" aria-label="主导航">
            {{navigation}}
            {{#if @site.members_enabled}}
                <a class="nav-subscribe" href="#/portal/signup">订阅</a>
            {{/if}}
        </nav>

        <div class="header-actions">
            <button class="icon-button" id="theme-toggle" type="button" aria-label="切换白天 / 夜间模式">
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                </svg>
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.5 14.4A8.5 8.5 0 0 1 9.6 3.5 8.5 8.5 0 1 0 20.5 14.4Z"></path>
                </svg>
            </button>

            <button class="icon-button menu-toggle" id="menu-toggle" type="button"
                    aria-controls="site-nav" aria-expanded="false" aria-label="打开菜单">
                <span class="menu-bar"></span>
                <span class="menu-bar"></span>
            </button>
        </div>
    </div>
</header>
