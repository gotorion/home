{{!< default}}
{{#author}}
<header class="archive-header container">
    <p class="eyebrow">作者</p>
    <div class="author-header">
        {{#if profile_image}}
            <img class="author-avatar" src="{{profile_image}}" alt="" loading="lazy">
        {{/if}}
        <div>
            <h1 class="archive-title">{{name}}</h1>
            {{#if bio}}
                <p class="archive-description">{{bio}}</p>
            {{/if}}
            <p class="archive-count">共 {{../pagination.total}} 篇文章</p>
        </div>
    </div>
</header>
{{/author}}

<section class="posts container">
    <div class="post-grid">
        {{#foreach posts}}
            {{> "post-card"}}
        {{else}}
            <div class="empty-state">
                <p>这位作者还没有发布文章。</p>
            </div>
        {{/foreach}}
    </div>

    {{pagination}}
</section>
