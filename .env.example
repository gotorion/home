# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，可以安全地保存密码

# 站点公开地址。本地开发：http://localhost:2368
# 部署到服务器后改成：https://your-domain.com
SITE_URL=http://localhost:2368

# 生产域名，只在使用 compose.prod.yml + Caddy 时需要
DOMAIN=

# Ghost 监听端口（默认只绑定 127.0.0.1）
GHOST_PORT=2368

# Ghost 镜像版本，建议与 Ghost 后台显示的版本保持一致
GHOST_VERSION=6-alpine

# 数据库凭据。生成方式：openssl rand -hex 16
# 注意：数据库初始化后不要再修改这几项
DATABASE_USER=ghost
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me-too

# 事务邮件（登录、邀请、密码重置；发 Newsletter 另需批量邮件服务）
# 本地开发可留空；部署后建议配置
# mail__transport=SMTP
# mail__options__host=smtp.example.com
# mail__options__port=465
# mail__options__secure=true
# mail__options__auth__user=no-reply@example.com
# mail__options__auth__pass=your-smtp-password
# mail__from="Your Name <no-reply@example.com>"
