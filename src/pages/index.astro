        .row {
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 8px 20px;
          padding: 20px 0;
        }

        .row-thumb {
          display: block;
          grid-column: 1 / -1;
          width: 100%;
          aspect-ratio: 16 / 10;
          object-fit: cover;
          margin-bottom: 12px;
          filter: grayscale(1) contrast(1.04);
