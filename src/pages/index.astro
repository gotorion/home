---
import '@fontsource-variable/archivo';

const year = new Date().getFullYear();
const email = 'lijunhui.yolo@gmail.com';
const [emailUser, emailDomain] = email.split('@');

const profile = {
  name: '李俊辉',
  role: '独立开发者 · 网站与产品',
  bio: '帮小团队把想法做成可上线的产品：从需求梳理、技术选型到开发上线，关注性能、可维护性与长期的迭代成本，也做技术咨询与一对一辅导。',
  avatar: '/avatar.svg',
  mailto: `mailto:${email}`,
};

const socials = [
  { label: 'GitHub', href: 'https://github.com/yourname' },
  { label: 'X', href: 'https://x.com/yourname' },
  { label: '抖音', href: 'https://www.douyin.com/user/yourname' },
  { label: '公众号', href: 'https://mp.weixin.qq.com/s/your-article' },
];

const shots = [
  { src: '/images/work-01.jpg', alt: '' },
  { src: '/images/work-03.jpg', alt: '' },
  { src: '/images/work-02.jpg', alt: '' },
  { src: '/images/work-04.jpg', alt: '' },
];

const services = [
  { title: '网站与产品开发', description: '从需求到上线，交付可维护的产品。' },
  { title: '技术咨询', description: '先看清问题，再决定是否动手。' },
  { title: '一对一辅导', description: '针对具体问题，给出下一步。' },
];

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`${profile.name} — ${profile.role}。${profile.bio}`} />
    <meta name="theme-color" content="#eeeeee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/alibaba-puhuiti-3-55.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{profile.name} — {profile.role}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="frame">
      <aside class="profile">
        <div class="media" aria-hidden="true">
          {
            shots.map((shot, index) => (
              <img
                class:list={['shot', { 'is-active': index === 0 }]}
                src={shot.src}
                alt={shot.alt}
                width="1000"
                height="1400"
                loading="eager"
                decoding="async"
              />
            ))
          }
        </div>

        <div class="identity">
          <img class="avatar reveal" src={profile.avatar} alt={`${profile.name} 的头像`} width="48" height="48" />
          <h1 class="reveal" style="--i: 1">{profile.name}</h1>
          <p class="role reveal" style="--i: 2">{profile.role}</p>
          <p class="bio reveal" style="--i: 3">{profile.bio}</p>
          <a class="mobile-cta reveal" style="--i: 4" href={profile.mailto}>聊聊合作<span aria-hidden="true">→</span></a>
          <ul class="socials reveal" style="--i: 5">
            {
              socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target={social.href.startsWith('http') ? '_blank' : undefined}
                    rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
                  >
                    {social.label}<span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <main class="reading">
        <section class="services" id="services" aria-labelledby="services-title">
          <h2 id="services-title" class="reveal">服务</h2>
          <div class="service-list">
            {
              services.map((service, index) => (
                <article class="service">
                  <h3 class="reveal" style={`--i: ${index * 2}`}>{service.title}</h3>
                  <p class="reveal" style={`--i: ${index * 2 + 1}`}>{service.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="contact" id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title" class="reveal">聊聊你的项目。</h2>
          <a class="email reveal" style="--i: 1" href={profile.mailto}>{emailUser}@<wbr />{emailDomain}</a>
          <a class="mail-button reveal" style="--i: 2" role="button" href={profile.mailto}>
            <span>写邮件给我</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="contact-foot reveal" style="--i: 3">© {year} {profile.name}</p>
        </section>
      </main>
    </div>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll('.reveal');

      const bootReveals = () => {
        if ('IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  revealObserver.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 }
          );
          reveals.forEach((el) => revealObserver.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add('is-in'));
        }
      };

      // Let the initial (hidden) state paint first so the entrance transitions actually run.
      window.setTimeout(bootReveals, 150);

      // The fixed photograph quietly cycles; it does not depend on scrolling.
      const shotEls = Array.from(document.querySelectorAll('.shot'));
      const shown = (index) => {
        shotEls.forEach((shot, i) => shot.classList.toggle('is-active', i === index));
      };

      if (!reduceMotion) {
        let current = 0;
        window.setInterval(() => {
          if (document.hidden) return;
          current = (current + 1) % shotEls.length;
          shown(current);
        }, 6000);
      }

      window.setTimeout(() => {
        if (!document.querySelector('.reveal.is-in')) {
          reveals.forEach((el) => el.classList.add('is-in'));
        }
      }, 2000);
    </script>

    <style>
      :global(:root) {
        --bg: #eeeeee;
        --surface: #e2e2e2;
        --ink: #161616;
        --muted: #6b6b6b;
        --accent: #7d0c14;
        --field: #7d0c14;
        --field-ink: #e2e2e2;
        --pad: 24px;
        --font: "Archivo Variable", "Archivo", "Alibaba PuHuiTi 3", ui-sans-serif, system-ui,
          -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
          sans-serif;
      }

      @font-face {
        font-family: "Alibaba PuHuiTi 3";
        src: url("/fonts/alibaba-puhuiti-3-55.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Alibaba PuHuiTi 3";
        src: url("/fonts/alibaba-puhuiti-3-75.woff2") format("woff2");
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }

      :global(html) {
        color-scheme: light;
      }

      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 18px;
        line-height: 1.55;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      :global(img) {
        max-width: 100%;
      }

      :global(a) {
        color: inherit;
      }

      :global(:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .frame {
        max-width: 1680px;
        margin: 0 auto;
        padding: var(--pad);
        display: grid;
        grid-template-columns: minmax(340px, 42%) minmax(0, 1fr);
        gap: var(--pad);
        align-items: start;
      }

      .profile {
        position: sticky;
        top: var(--pad);
        height: calc(100svh - var(--pad) * 2);
        overflow: hidden;
        background: var(--surface);
      }

      .media {
        position: absolute;
        inset: 0;
      }

      .shot {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.04);
        opacity: 0;
        transition: opacity 1.6s ease;
      }

      .shot.is-active {
        opacity: 1;
        animation: drift 22s ease-in-out infinite alternate;
      }

      @keyframes drift {
        from {
          transform: scale(1);
        }
        to {
          transform: scale(1.025);
        }
      }

      .identity {
        position: absolute;
        left: 16px;
        right: 16px;
        bottom: 16px;
        padding: 24px;
        background: var(--bg);
      }

      .avatar {
        display: block;
        width: 48px;
        height: 48px;
        object-fit: cover;
        background: var(--surface);
      }

      h1 {
        margin: 14px 0 2px;
        font-size: clamp(2rem, 3.6vw, 3.25rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      .role {
        margin: 0 0 12px;
        font-size: 1.125rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }

      .bio {
        margin: 0;
        max-width: 34ch;
        font-size: 1.125rem;
        line-height: 1.5;
      }

      .mobile-cta {
        display: none;
      }

      .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
      }

      .socials a {
        font-size: 1.125rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .socials a span {
        margin-left: 2px;
        color: var(--muted);
      }

      .socials a:hover {
        color: var(--accent);
      }

      .reading {
        min-width: 0;
        min-height: calc(100svh - var(--pad) * 2);
        padding: 56px 0 0 clamp(24px, 4.5vw, 72px);
        display: flex;
        flex-direction: column;
      }

      .services {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .services h2 {
        margin: 0;
        font-size: clamp(2rem, 3.6vw, 3.25rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.035em;
      }

      .service-list {
        display: flex;
        flex-direction: column;
        gap: clamp(20px, 4vh, 40px);
        margin-top: clamp(20px, 3vh, 32px);
      }

      @media (min-width: 981px) {
        .service-list {
          flex: 1;
          justify-content: space-evenly;
          gap: 0;
          margin-top: 0;
        }
      }

      .service h3 {
        margin: 0 0 4px;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .service p {
        margin: 0;
        max-width: 46ch;
        font-size: 1.125rem;
        line-height: 1.5;
      }

      .contact {
        margin-top: auto;
        margin-left: calc(clamp(24px, 4.5vw, 72px) * -1);
        padding: 28px 24px 24px clamp(24px, 4.5vw, 72px);
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--field);
        color: var(--field-ink);
      }

      .contact h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }

      .email {
        display: block;
        font-size: clamp(2rem, 3.2vw, 3.5rem);
        font-weight: 400;
        line-height: 1.06;
        letter-spacing: -0.045em;
        color: var(--field-ink);
        text-decoration: none;
        overflow-wrap: anywhere;
        transition: color 0.2s ease;
      }

      .email:hover {
        color: #ffffff;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.08em;
      }

      .mail-button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 48px;
        margin-right: -24px;
        padding: 0 24px;
        background: var(--field-ink);
        color: var(--field);
        font-size: 1.125rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      .mail-button:hover {
        background: #ffffff;
      }

      .mail-button span:last-child {
        transition: transform 0.2s ease;
      }

      .mail-button:hover span:last-child {
        transform: translateX(3px);
      }

      .contact-foot {
        margin: 0;
        font-size: 1rem;
      }

      .js .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(var(--i, 0) * 80ms);
      }

      .js .reveal.is-in {
        opacity: 1;
        transform: none;
      }

      @media (min-width: 981px) and (max-height: 760px) {
        .reading {
          padding-top: 40px;
        }

        .contact {
          gap: 10px;
          padding-top: 22px;
          padding-bottom: 18px;
        }

        .contact h2 {
          font-size: 1.125rem;
        }

        .email {
          font-size: clamp(1.75rem, 2.8vw, 3rem);
        }
      }

      @media (max-width: 980px) {
        .frame {
          grid-template-columns: 1fr;
        }

        .profile {
          position: static;
          height: auto;
        }

        .media {
          position: relative;
          height: 50svh;
        }

        .identity {
          position: static;
          padding: 24px;
        }

        .mobile-cta {
          display: inline-flex;
          align-items: center;
          gap: 10px;
          height: 46px;
          margin-top: 18px;
          padding: 0 18px;
          background: var(--accent);
          color: #ffffff;
          font-size: 1.125rem;
          font-weight: 600;
          text-decoration: none;
          transition: background-color 0.2s ease;
        }

        .mobile-cta:hover {
          background: var(--ink);
        }

        .mobile-cta span {
          transition: transform 0.2s ease;
        }

        .mobile-cta:hover span {
          transform: translateX(3px);
        }

        .reading {
          min-height: 0;
          padding: 56px 24px 0;
        }

        .contact {
          margin-top: 48px;
          margin-left: -24px;
          margin-right: -24px;
          padding: 32px 24px 28px;
        }

        .mail-button {
          margin-right: -24px;
        }

        .email {
          font-size: clamp(1.75rem, 8.2vw, 2.5rem);
        }
      }

      @media (max-width: 560px) {
        .media {
          height: 44svh;
        }

        h1 {
          font-size: clamp(2rem, 11vw, 2.75rem);
        }

        .identity {
          padding: 22px;
        }

        .mobile-cta {
          height: 48px;
        }

        .socials {
          gap: 14px;
        }

        .reading {
          padding: 44px 20px 0;
        }

        .contact {
          margin-left: -20px;
          margin-right: -20px;
          padding: 32px 20px 24px;
        }

        .mail-button {
          margin-right: -20px;
          padding: 0 20px;
        }

        .email {
          font-size: clamp(1.5rem, 8.2vw, 2.25rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .shot {
          transition: none;
          animation: none;
        }

        .js .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </body>
</html>
